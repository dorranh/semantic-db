{
  "profile": "scripted-provider-orchestration-v1",
  "claim": "Deterministic compiler and retrieval checks only; no live-model accuracy claim.",
  "cases": [
    {
      "id": "active_orders",
      "request": "List active orders",
      "modes": ["full", "retrieved"],
      "competing_alias": true,
      "scripted_output": {
        "status": "query",
        "query": {
          "version": 1,
          "input": {"relation": "orders", "instance": "o"},
          "requirements": [
            {"id": "active", "source_text": "active", "operation": {"kind": "concept_filter", "concept": "active"}},
            {"id": "id", "source_text": "order IDs", "operation": {"kind": "project", "field": {"instance": "o", "field": "id"}, "alias": "id"}}
          ],
          "unresolved": []
        }
      },
      "expected": {"outcome": "compiled", "rows": [["1"], ["3"]], "requirement_ids": ["active", "id"]}
    },
    {
      "id": "competing_open_alias",
      "request": "List open orders",
      "modes": ["full", "retrieved"],
      "competing_alias": true,
      "scripted_output": {
        "status": "query",
        "query": {
          "version": 1,
          "input": {"relation": "orders", "instance": "o"},
          "requirements": [
            {"id": "open", "source_text": "open", "operation": {"kind": "concept_filter", "concept": "open"}},
            {"id": "id", "source_text": "order IDs", "operation": {"kind": "project", "field": {"instance": "o", "field": "id"}, "alias": "id"}}
          ],
          "unresolved": []
        }
      },
      "expected": {"outcome": "rejected", "diagnostic": "ambiguous_concept"}
    },
    {
