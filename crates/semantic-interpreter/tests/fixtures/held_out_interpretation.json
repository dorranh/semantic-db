    {
      "id": "exact_numeric_cutoff",
      "request": "List order IDs with an amount of at least 20",
      "modes": ["full", "retrieved"],
      "competing_alias": false,
      "scripted_output": {
        "status": "query",
        "query": {
          "version": 1,
          "input": {"relation": "orders", "instance": "o"},
          "requirements": [
            {"id": "cutoff", "source_text": "at least 20", "operation": {"kind": "filter", "predicate": {"kind": "compare", "field": {"instance": "o", "field": "amount"}, "operator": "gt_eq", "value": {"type": "int64", "value": 20}}}},
            {"id": "id", "source_text": "order IDs", "operation": {"kind": "project", "field": {"instance": "o", "field": "id"}, "alias": "id"}}
          ],
          "unresolved": []
        }
      },
      "expected": {"outcome": "compiled", "rows": [["2"], ["3"]], "requirement_ids": ["cutoff", "id"]}
    },
    {
      "id": "cross_domain_open_requires_clarification",
      "request": "Show open records across orders and refunds",
      "modes": ["full", "retrieved"],
      "competing_alias": false,
      "scripted_output": {"status": "needs_clarification", "phrases": ["open"], "question": "Do you mean open orders or open refunds?"},
      "expected": {"outcome": "needs_clarification"}
    }
