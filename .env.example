# Copy to .env in the repository root and fill in the key. Never commit .env.
OPENAI_API_KEY=

# Optional: defaults shown here. Use your provider's model identifier and API root.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
# Set false for compatible providers that do not support response_format.
OPENAI_JSON_MODE=true
