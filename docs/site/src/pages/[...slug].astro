---
import { getCollection, render } from 'astro:content';
import Docs from '../layouts/Docs.astro';
import { titleOf } from '../lib/navigation';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map(entry => ({
    params: { slug: entry.id === 'generated/site-home' ? undefined : entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const source = entry.filePath?.replace(/^\.\.\//, 'docs/');
---
<Docs title={titleOf(entry)} id={entry.id} headings={headings} source={source}>
  <Content />
</Docs>
