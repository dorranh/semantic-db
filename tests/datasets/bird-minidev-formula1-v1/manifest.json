{
  "format_version": 1,
  "id": "bird-minidev-formula1-v1",
  "version": "1.0.3",
  "project": "semantic-db.yaml",
  "cases": "cases.json",
  "schemas": "schemas.json",
  "execution": {
    "max_requests": 1024
  },
  "required_paired_cases": 66,
  "required_companion_cases": 0,
  "context": {
    "reference_time": "2026-10-04T00:00:00Z",
    "timezone": "UTC"
