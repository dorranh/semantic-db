  "environment": {
    "compose_files": [
      "compose.yaml"
    ],
    "services": [
      "postgres"
    ],
    "bootstrap_service": "bootstrap",
    "startup_timeout_seconds": 120,
    "bootstrap_timeout_seconds": 180,
    "bindings": {
      "BIRD_DATABASE_URL": {
        "service": "postgres",
        "port": 5432,
        "template": "postgres://bird:bird@{host}:{port}/bird?sslmode=disable"
      }
    }
  },
  "fixtures": [
