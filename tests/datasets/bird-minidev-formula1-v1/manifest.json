      "expected": "expected/fixture-constructorstandings.json"
    },
    {
      "sql": "SELECT COUNT(*) AS row_count FROM constructors",
      "expected": "expected/fixture-constructors.json"
    },
    {
      "sql": "SELECT COUNT(*) AS row_count FROM driverstandings",
      "expected": "expected/fixture-driverstandings.json"
    },
    {
      "sql": "SELECT COUNT(*) AS row_count FROM drivers",
      "expected": "expected/fixture-drivers.json"
    },
    {
      "sql": "SELECT COUNT(*) AS row_count FROM laptimes",
